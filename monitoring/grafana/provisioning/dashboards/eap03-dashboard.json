        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "system_cpu_usage{environment=~\"$environment\"}",
          "legendFormat": "CPU Sistema"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
